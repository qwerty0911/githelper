{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "verify-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MONGODB_DB=github_helper_verify",
        ".venv/bin/uvicorn",
        "app.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "verify-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_TARGET=http://localhost:8001",
        "npm",
        "--prefix",
        "frontend",
        "exec",
        "--",
        "vite",
        "frontend",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
